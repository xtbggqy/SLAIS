# ===============================
# SLAIS 项目环境变量配置示例
# ===============================

# 本文件用于配置SLAIS项目的各项环境变量。
# 请复制此文件为 .env，并在其中填写您的实际配置。
# .env 文件不应提交到版本控制系统。

# ================================
# 核心LLM API配置 (必需)
# ================================

# 默认API服务商 (Web UI中默认选中的接口)
# 可选值: "阿里云", "OpenAI", "Gemini", "xAI", "DeepSeek", "OpenRouter"
DEFAULT_API_PROVIDER="阿里云"

# OpenAI API 配置 (主要文本分析模型)
# 您的OpenAI API密钥
OPENAI_API_KEY=""
# 默认文本分析模型 (推荐: gpt-4o, gpt-4-turbo)
OPENAI_API_MODEL="gpt-4o"
# OpenAI API端点
OPENAI_API_BASE_URL="https://api.openai.com/v1"
# 模型温度，控制输出随机性 (0.0-1.0)
OPENAI_TEMPERATURE="0.1"

# 阿里云 DashScope API 配置 (可选，支持通义千问系列)
# 阿里云DashScope API密钥
DASHSCOPE_API_KEY=""
# 如果设置了DASHSCOPE_API_KEY，可使用兼容模式：
# OPENAI_API_BASE_URL="https://dashscope.aliyuncs.com/compatible-mode/v1"

# 图像理解大模型配置 (用于PDF图像内容分析)
# 图像分析API密钥 (可与OPENAI_API_KEY相同)
IMAGE_LLM_API_KEY=""
# 图像分析模型 (推荐: qwen-vl-plus, gpt-4o)
IMAGE_LLM_API_MODEL="qwen-vl-plus"
# 图像分析API端点 (如与文本API不同则设置)
IMAGE_LLM_API_BASE_URL=""
# 图像分析模型温度
IMAGE_LLM_TEMPERATURE="0.1"

# ================================
# MinerU PDF解析API配置 (必需)
# ================================

# MinerU API密钥 (从 https://mineru.net 获取)
MINERU_API_KEY=""
# MinerU API基础URL
MINERU_API_BASE_URL="https://mineru.net/api/v4"
# 最大等待时间(秒) - 大文件可能需要更长时间
MINERU_MAX_WAIT_TIME="3600"
# 检查任务状态间隔(秒)
MINERU_CHECK_INTERVAL="10"
# 上传失败最大重试次数
MINERU_MAX_RETRIES="3"
# 重试基础延迟(秒，实际延迟=delay×尝试次数)
MINERU_RETRY_DELAY="5"

# ================================
# 学术数据库API配置 (推荐)
# ================================

# NCBI/PubMed API 配置
# 您的邮箱地址 (NCBI API要求，用于标识用户)
NCBI_EMAIL="your_email@example.com"

# Semantic Scholar API 配置
# Semantic Scholar API密钥 (可选，但推荐以获取更高请求速率)
SEMANTIC_SCHOLAR_API_KEY=""

# ================================
# 多平台LLM支持 (可选扩展)
# ================================

# 以下为Web UI中支持的各种LLM平台默认模型配置
# 如未设置，将使用 slais/config.py 中的硬编码默认值

# OpenAI系列模型
DEFAULT_OPENAI_TEXT_MODEL="gpt-4o"
DEFAULT_OPENAI_IMAGE_MODEL="gpt-4o"

# Google Gemini系列
DEFAULT_GEMINI_TEXT_MODEL="gemini-1.5-pro-latest"
DEFAULT_GEMINI_IMAGE_MODEL="gemini-pro-vision"
# Google Gemini API密钥
GEMINI_API_KEY=""

# xAI Grok系列
DEFAULT_XAI_TEXT_MODEL="grok-3"
DEFAULT_XAI_IMAGE_MODEL="grok-2-vision-1212"
# xAI API密钥
XAI_API_KEY=""

# 阿里云通义千问系列
DEFAULT_ALIYUN_TEXT_MODEL="qwen-turbo"
DEFAULT_ALIYUN_IMAGE_MODEL="qwen-vl-plus"

# DeepSeek系列
DEFAULT_DEEPSEEK_TEXT_MODEL="deepseek-chat"
# DeepSeek API密钥
DEEPSEEK_API_KEY=""

# OpenRouter (多模型聚合平台)
DEFAULT_OPENROUTER_TEXT_MODEL="openrouter-auto"
# OpenRouter API密钥
OPENROUTER_API_KEY=""

# ================================
# 文档处理与路径配置
# ================================

# PDF文件路径配置
# 存放输入PDF文件的目录
PDF_INPUT_DIR="pdfs"
# 未指定输入时默认处理的PDF文件路径
DEFAULT_PDF_PATH="pdfs/example.pdf"

# 文章DOI配置 (重要：替换为实际要分析的文献DOI)
# 示例DOI，请替换为实际文献DOI
ARTICLE_DOI="10.1126/science.aao4593"

# 输出目录配置
# 分析结果的输出根目录
OUTPUT_BASE_DIR="output"
# Markdown输出子目录名（如不设置则自动为 <PDF文件名>_markdown）
# MARKDOWN_SUBDIR=""

# ================================
# 系统配置
# ================================

# 缓存配置
# 缓存文件存放目录
CACHE_DIR="cache"
# 缓存有效期 (天)
CACHE_EXPIRY_DAYS="30"

# 日志配置
# 日志级别 (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL="INFO"
# 日志文件存放目录
LOG_DIR="logs"

# ================================
# 分析参数配置 (性能调优)
# ================================

# LLM分析参数
# 传递给LLM进行分析的最大内容字符数 (根据模型上下文窗口调整)
MAX_CONTENT_CHARS_FOR_LLM="500000"
# LLM生成问答对的最大数量
MAX_QUESTIONS_TO_GENERATE="25"

# 文献检索参数
# 检索相关文献时回溯的年数
RELATED_ARTICLES_YEARS_BACK="10"
# 获取相关文章的最大数量
RELATED_ARTICLES_MAX="50"

# ================================
# API客户端高级配置 (通常无需修改)
# ================================

# PubMed API 详细配置
PUBMED_API_BASE_URL="https://eutils.ncbi.nlm.nih.gov/entrez/eutils/"
# 工具标识名称
PUBMED_TOOL_NAME="slais_pubmed_client"
# 批量获取文章详情的批次大小
PUBMED_EFETCH_BATCH_SIZE="200"
# 请求超时时间(秒)
PUBMED_REQUEST_TIMEOUT="45.0"
# 请求间隔(秒，遵守NCBI使用政策)
PUBMED_REQUEST_DELAY="0.35"
# 失败重试次数
PUBMED_RETRY_COUNT="3"

# Semantic Scholar API 详细配置
SEMANTIC_SCHOLAR_API_BASE_URL="https://api.semanticscholar.org/graph/v1"
SEMANTIC_SCHOLAR_GRAPH_API_BASE_URL="https://api.semanticscholar.org/graph/v1"
# 批处理大小
SEMANTIC_SCHOLAR_API_BATCH_SIZE="25"
# 请求间隔(秒)
SEMANTIC_SCHOLAR_REQUEST_DELAY="0.2"
# 重试次数
SEMANTIC_SCHOLAR_RETRY_COUNT="3"
# 请求超时(秒)
SEMANTIC_SCHOLAR_TIMEOUT="30.0"
# 每页最大参考文献数
SEMANTIC_SCHOLAR_MAX_REFERENCES_PER_PAGE="100"

# Semantic Scholar 高级配置
# S2 API请求超时时间
S2_REQUEST_TIMEOUT="45.0"
# 连接池限制
S2_CONN_LIMIT="10"
# 重试次数
S2_RETRY_COUNT="3"
# 基础重试延迟
S2_BASE_RETRY_DELAY="2.0"
# 抖动因子
S2_JITTER_FACTOR="0.25"
# 有API密钥时的速率限制(请求/小时)
S2_RATE_LIMIT_WITH_KEY="800"
# 无API密钥时的速率限制(请求/小时)
S2_RATE_LIMIT_WITHOUT_KEY="120"
# 速率限制缓冲因子
S2_RATE_LIMIT_BUFFER_FACTOR="0.8"
# 默认获取字段
S2_DEFAULT_FIELDS="paperId,externalIds,url,title,abstract,venue,year,referenceCount,citationCount,influentialCitationCount,isOpenAccess,fieldsOfStudy,publicationTypes,authors,authors.name,authors.url"
# 参考文献字段
S2_REFERENCES_FIELDS="citedPaper.externalIds"
# 参考文献获取限制
S2_REFERENCES_LIMIT="1000"

# 全局网络配置
# 默认请求超时时间 (秒)
DEFAULT_REQUEST_TIMEOUT="30.0"

# ================================
# Web应用配置 (Streamlit)
# ================================

# Streamlit应用配置
# Web应用端口
STREAMLIT_SERVER_PORT="8501"
# Web应用地址
STREAMLIT_SERVER_ADDRESS="localhost"
# 禁用使用统计收集
STREAMLIT_BROWSER_GATHER_USAGE_STATS="false"

# 上传文件配置
# 最大上传文件大小(MB)
MAX_UPLOAD_SIZE_MB="200"
# 允许的文件扩展名
ALLOWED_FILE_EXTENSIONS=".pdf,.doc,.docx"

# ================================
# 开发和调试配置 (可选)
# ================================

# 调试模式
# 是否启用调试模式
DEBUG_MODE="false"
# 是否启用详细日志
VERBOSE_LOGGING="false"

# 测试配置
# 测试模式，使用模拟数据
TEST_MODE="false"
# 是否模拟API响应
MOCK_API_RESPONSES="false"

# 性能监控
# 是否启用性能监控
ENABLE_PERFORMANCE_MONITORING="false"
# 性能日志记录间隔(秒)
PERFORMANCE_LOG_INTERVAL="60"

# Token使用统计
# 是否启用Token使用统计
ENABLE_TOKEN_TRACKING="true"
# 是否启用成本跟踪
TOKEN_COST_TRACKING="true"
